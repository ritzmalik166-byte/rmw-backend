# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.vscode/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Generated at build time (postbuild) — do not commit; server regenerates on each deploy
public/sitemap.xml
public/sitemap-0.xml
public/page-sitemap.xml
public/post-sitemap.xml
public/images-sitemap.xml
data/sitemap-0-base.xml
